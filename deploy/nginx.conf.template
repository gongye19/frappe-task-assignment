upstream frappe-backend {
  server 127.0.0.1:8000 fail_timeout=0;
}

upstream frappe-socketio {
  server 127.0.0.1:9000 fail_timeout=0;
}

map $http_x_forwarded_proto $proxy_x_forwarded_proto {
  default $scheme;
  https https;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  # Railway's edge reaches services over its dual-stack private mesh. Bind
  # IPv6 and IPv4 on one socket instead of relying on IPv6-to-IPv4 fallback.
  listen [::]:${PORT} ipv6only=off;
  server_name _;
  absolute_redirect off;
  root /home/frappe/frappe-bench/sites;

  proxy_buffer_size 128k;
  proxy_buffers 4 256k;
  proxy_busy_buffers_size 256k;

  location /assets {
    try_files $uri =404;
  }

  location ~ ^/protected/(.*) {
    internal;
    try_files /${SITE_NAME}/$1 =404;
  }

  location /socket.io {
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
    proxy_set_header Host $http_host;
    proxy_set_header Origin "$proxy_x_forwarded_proto://$http_host";
    proxy_buffering off;
    proxy_read_timeout 86400;
    proxy_send_timeout 86400;
    proxy_pass http://frappe-socketio;
  }

  location / {
    rewrite ^(.+)/$ $1 permanent;
    rewrite ^(.+)/index\.html$ $1 permanent;
    rewrite ^(.+)\.html$ $1 permanent;

    location ~ ^/files/.*\.(htm|html|svg|xml)$ {
      add_header Content-Disposition "attachment";
      try_files /${SITE_NAME}/public/$uri @frappe-web;
    }

    try_files /${SITE_NAME}/public/$uri @frappe-web;
  }

  location @frappe-web {
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    proxy_set_header X-Frappe-Site-Name ${SITE_NAME};
    proxy_set_header Host $http_host;
    proxy_set_header X-Use-X-Accel-Redirect True;
    proxy_read_timeout 120;
    proxy_redirect off;
    proxy_pass http://frappe-backend;
  }

  sendfile on;
  keepalive_timeout 15;
  client_max_body_size 50m;

  gzip on;
  gzip_http_version 1.1;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_proxied any;
  gzip_vary on;
  gzip_types application/javascript application/json application/xml font/woff image/svg+xml text/css text/plain;
}
